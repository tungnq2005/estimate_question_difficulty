su9:M_CH2_CongNhan_1919_1925 a su9:Movement ;
    rdfs:label "Phong trào công nhân (1919-1925)"@vi ;
    su9:aliases "Công nhân 1919-1925|Công nhân Nam Định|Công nhân Cẩm Phả" ;
    su9:occursAt su9:L_VietNam ;
    su9:occursDuring su9:P_1919_1925 ;
    su9:hasContent "Diễn ra lẻ tẻ. Chủ yếu phá hợp đồng, bỏ trốn, lãn công đòi quyền lợi kinh tế tại Nam Định, Cẩm Phả, Hà Nội." ;
    su9:hasLimitations "Chưa có tổ chức và lãnh đạo thống nhất, mang tính tự phát." ;
    su9:hasOrganization su9:O_CongNhanVN ;
    su9:weightsJson "{\"O_CongNhanVN\": 10}" .
su9:M_CH2_CongNhan_1925_1930 a su9:Movement ;
    rdfs:label "Phong trào công nhân (1925-1930)"@vi ;
    su9:aliases "Bãi công Ba Son|Công nhân Phú Riềng|Công nhân 1925-1930" ;
    su9:occursAt su9:L_VietNam ;
    su9:occursDuring su9:P_1925_1930 ;
    su9:hasContent "Nổ ra nhiều nơi, có tổ chức và lãnh đạo (Công hội). Mục đích kết hợp đòi quyền lợi kinh tế và mục đích chính trị rõ ràng. Tiêu biểu: Ba Son (Sài Gòn), Phú Riềng (Bình Phước), A-vi-a (Hà Nội)." ;
    su9:hasOrganization su9:O_CongNhanVN ;
    su9:hasOrganization su9:O_CongHoi ;
    su9:involvedConcept su9:C_BaiCong ;
    su9:weightsJson "{\"O_CongNhanVN\": 10, \"O_CongHoi\": 9, \"C_BaiCong\": 10}" .
su9:M_CH2_PhongTrao_1930_1931 a su9:Movement ;
    rdfs:label "Phong trào cách mạng 1930-1931"@vi ;
    su9:aliases "Phong trào 1930-1931|Cách mạng 1930-1931" ;
    su9:occursAt su9:L_VietNam ;
    su9:occursDuring su9:P_1930_1931 ;
    su9:hasCause "Ảnh hưởng khủng hoảng 1929-1933; Mâu thuẫn dân tộc và giai cấp sâu sắc; Đảng Cộng sản vừa ra đời đã kịp thời lãnh đạo." ;
    su9:hasContent "Bùng nổ từ đầu năm 1930. Từ tháng 5/1930, phát triển mạnh mẽ cả nước. Đỉnh cao tháng 9, 10/1930 ở Nghệ An và Hà Tĩnh." ;
    su9:hasAchievements "Khẳng định vai trò lãnh đạo của Đảng; Hình thành khối liên minh công-nông." ;
    su9:hasLimitations "Bị thực dân Pháp khủng bố tàn bạo, phong trào tạm thời lắng xuống từ đầu năm 1931." ;
    su9:hasOrganization su9:O_DangCongSanVN ;
    su9:hasOrganization su9:O_CongNhanVN ;
    su9:involvedConcept su9:C_LienMinhCongNong ;
    su9:involvedConcept su9:C_TapDuotCachMang ;

su9:E_CH5_DaCuc_HinhThanh a su9:Event ;
    rdfs:label "Xu hướng đa cực đầu thế kỷ XXI"@vi ;
    su9:occursAt su9:L_Global ;
    su9:occursDuring su9:P_Tu2001 ;
    su9:hasContent "+ Trung Quốc: Trỗi dậy mạnh mẽ, thực hiện chiến lược 'Vành đai, con đường'.\n+ Nga: Khôi phục vị thế, chống lại sự mở rộng về phía Đông của NATO.\n+ EU, Nhật Bản, Ấn Độ: Tham gia vào quá trình cạnh tranh quyền lực." ;
    su9:hasAchievements "Xu hướng đa cực dần được thể hiện rõ với nhiều trung tâm cạnh tranh, chấm dứt thời kỳ Mỹ 'một mình một ngựa'." ;
    su9:involvedConcept su9:C_TratTuDaCuc ;

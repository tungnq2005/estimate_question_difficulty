su9:M_GiaiPhongDanToc_DongNamA_1918_1945 a su9:Movement ;
    rdfs:label "Phong trào GPDT Đông Nam Á"@vi ;
    su9:aliases "Giải phóng dân tộc Đông Nam Á|Cách mạng Đông Nam Á|Phong trào đấu tranh Đông Nam |Phong trào giải phóng dân tộc ở Đông Nam Á" ;
    su9:occursAt su9:L_DongNamA ;
    su9:occursDuring su9:P_1918_1945 ;
    su9:hasCause "Ách thống trị bóc lột của chủ nghĩa thực dân phương Tây." ;
    su9:hasContent "Phát triển theo 2 khuynh hướng (vô sản và tư sản). Lập mặt trận chống Nhật trong WWII." ;
    su9:hasResult "Chớp thời cơ Nhật đầu hàng, Indonesia và Việt Nam giành độc lập (8/1945)." ;

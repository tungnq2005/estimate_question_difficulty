    su9:occursDuring su9:P_1939_1945 ;
    su9:hasCause "Chính sách thống trị tàn bạo của Pháp-Nhật làm mâu thuẫn dân tộc gay gắt." ;
    su9:hasContent "Bao gồm khởi nghĩa Bắc Sơn (9/1940), Nam Kì (11/1940) và binh biến Đô Lương (1/1941)." ;
    su9:hasResult "Báo hiệu thời kì đấu tranh vũ trang, khởi nghĩa vũ trang giành chính quyền." .
su9:M_CH2_CaoTraoKhangNhat a su9:Movement ;
    rdfs:label "Cao trào Kháng Nhật cứu nước"@vi ;
    su9:aliases "Cao trào Kháng Nhật cứu nước|Kháng Nhật cứu nước|Tiền khởi nghĩa" ;
    su9:occursAt su9:L_VietNam ;
    su9:occursDuring su9:P_Mar_Aug_1945 ;
    su9:hasContent "Phát triển mạnh mẽ. Ở Việt Bắc: giải phóng hàng loạt xã, châu. Ở Bắc Kì và Bắc Trung Kì: dấy lên phong trào 'Phá kho thóc, giải quyết nạn đói'." ;
    su9:hasAchievements "Là cuộc tập dượt lần thứ ba của Đảng và quần chúng cho Cách mạng tháng Tám." ;
    su9:hasOrganization su9:O_DangCongSanVN ;
    su9:hasOrganization su9:O_VietMinh ;
    su9:hasOrganization su9:O_VNTTGPQ ;
    su9:involvedConcept su9:C_PhaKhoThoc ;
    su9:involvedConcept su9:C_TapDuotCachMang ;

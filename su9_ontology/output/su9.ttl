su9:M_CH2_DauTranhTuSan_1919_1923 a su9:Movement ;
    rdfs:label "Phong trào đấu tranh của giai cấp tư sản (1919-1923)"@vi ;
    su9:aliases "Chấn hưng nội hoá|Chống độc quyền cảng Sài Gòn|Phong trào tư sản" ;
    su9:occursAt su9:L_SaiGon ;
    su9:occursDuring su9:P_1918_1930 ;
    su9:hasContent "Đi đầu trong phong trào 'chấn hưng nội hoá, bài trừ ngoại hoá' (1919). Đấu tranh chống tư bản Pháp độc quyền cảng Sài Gòn và xuất cảng lúa gạo ở Nam Kỳ (1923)." ;
    su9:hasOrganization su9:O_TuSanVN ;
    su9:involvedConcept su9:C_ChanHungNoiHoa ;
    su9:weightsJson "{\"O_TuSanVN\": 10, \"C_ChanHungNoiHoa\": 10}" .
su9:M_CH2_DauTranhTieuTuSan_1925_1926 a su9:Movement ;
    rdfs:label "Phong trào đấu tranh của tiểu tư sản (1925-1926)"@vi ;
    su9:aliases "Đòi thả Phan Bội Châu|Truy điệu Phan Châu Trinh|Tiểu tư sản đấu tranh" ;
    su9:occursAt su9:L_VietNam ;
    su9:occursDuring su9:P_1918_1930 ;
    su9:hasContent "Lập nhà xuất bản tiến bộ (Cường học thư xã, Nam Đồng thư xã), ra báo (Chuông rè, An Nam trẻ). Tổ chức đòi thả Phan Bội Châu (1925), Nguyễn An Ninh (1926), đám tang Phan Châu Trinh (1926)." ;
    su9:hasPerson su9:Pe_PhanBoiChau ;
    su9:hasPerson su9:Pe_NguyenAnNinh ;
    su9:hasPerson su9:Pe_PhanChauTrinh ;

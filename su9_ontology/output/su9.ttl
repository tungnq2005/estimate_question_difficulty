### MOVEMENTS ###
su9:M_CachMang_ChauAu_1918_1923 a su9:Movement ;
    rdfs:label "Phong trào cách mạng ở châu Âu (1918-1923)"@vi ;
    su9:aliases "Cách mạng châu Âu|Phong trào cách mạng 1918-1923|Cách mạng 1918-1923|Phong trào cách mạng ở các nước tư bản châu Âu" ;
    su9:occursAt su9:L_Europe ;
    su9:occursDuring su9:P_1918_1923 ;
    su9:hasCause "Do hậu quả nặng nề của Chiến tranh thế giới thứ nhất và tác động của Cách mạng tháng Mười Nga năm 1917, vào những năm 1918-1923, một phong trào cách mạng đã bùng nổ ở hầu khắp các nước tư bản châu Âu." ;
    su9:hasContent "Nhân dân Béc-lin lật đổ quân chủ (11/1918). Bãi công lớn ở Anh, Pháp." ;
    su9:hasResult "Dẫn đến sự thành lập hàng loạt Đảng Cộng sản (Đức, Pháp, Anh, Italia)." ;
    su9:involvedConcept su9:C_KhuynhHuongVoSan ;
    su9:weightsJson "{\"C_KhuynhHuongVoSan\": 10}" .
su9:M_NguTu_1919 a su9:Movement ;
    rdfs:label "Phong trào Ngũ Tứ"@vi ;
    su9:aliases "Ngũ Tứ|Phong trào mùng 4 tháng 5|Cách mạng Ngũ Tứ" ;
    su9:occursAt su9:L_BacKinh ;
    su9:occursDuring su9:P_1918_1923 ;
    su9:hasCause "Chống lại âm mưu xâu xé Trung Quốc của các đế quốc." ;
    su9:hasContent "Bùng nổ 4/5/1919, lôi cuốn công nhân, trí thức tham gia." ;
    su9:hasResult "Lan rộng cả nước, thúc đẩy sự ra đời của Đảng Cộng sản Trung Quốc (1921)." ;
    su9:involvedConcept su9:C_KhuynhHuongVoSan ;
    su9:weightsJson "{\"C_KhuynhHuongVoSan\": 8}" .
su9:M_DauTranh_AnDo_Interwar a su9:Movement ;
    rdfs:label "Phong trào đấu tranh giành độc lập ở Ấn Độ"@vi ;
    su9:aliases "Cách mạng Ấn Độ|Phong trào giải phóng dân tộc Ấn Độ|Đấu tranh giành độc lập Ấn Độ" ;
    su9:occursAt su9:L_AnDo ;
    su9:occursDuring su9:P_1918_1939 ;
    su9:hasContent "Dưới sự lãnh đạo của Gan-đi, nhân dân đấu tranh đòi độc lập, tẩy chay hàng hoá của Anh." ;
    su9:hasPerson su9:Pe_Gandhi ;
    su9:hasOrganization su9:O_DangQuocDai ;
    su9:hasOrganization su9:O_DangCongSan_AnDo ;
    su9:involvedConcept su9:C_KhuynhHuongTuSan ;
    su9:involvedConcept su9:C_GiaiPhongDanToc ;

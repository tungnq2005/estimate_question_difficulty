    math:abstractness 2 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_DienTichHinhTron a math:Formula ;
    rdfs:label "Dien tich hinh tron S = pi*R^2"@vi ;
    math:symbolicDensity 2 ;
    math:applicationSteps 1 ;
    math:abstractness 2 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_DTXQHinhTru a math:Formula ;
    rdfs:label "Dien tich xung quanh hinh tru S_xq = 2*pi*R*h"@vi ;
    math:symbolicDensity 3 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_TheTichHinhTru a math:Formula ;
    rdfs:label "The tich hinh tru V = pi*R^2*h"@vi ;
    math:symbolicDensity 3 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_DTXQHinhNon a math:Formula ;
    rdfs:label "Dien tich xung quanh hinh non S_xq = pi*R*l"@vi ;
    math:symbolicDensity 3 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_TheTichHinhNon a math:Formula ;
    rdfs:label "The tich hinh non V = (1/3)*pi*R^2*h"@vi ;
    math:symbolicDensity 4 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_DienTichHinhCau a math:Formula ;
    rdfs:label "Dien tich mat cau S = 4*pi*R^2"@vi ;
    math:symbolicDensity 3 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_TheTichHinhCau a math:Formula ;
    rdfs:label "The tich hinh cau V = (4/3)*pi*R^3"@vi ;
    math:symbolicDensity 4 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_HSL_BinhPhuong_TGV a math:Formula ;
    rdfs:label "b^2 = a*b', c^2 = a*c' (HSL trong TGV)"@vi ;
    math:symbolicDensity 3 ;
    math:applicationSteps 2 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_HSL_DuongCao_TGV a math:Formula ;
    rdfs:label "h^2 = b'*c' (HSL trong TGV)"@vi ;

#################################################################
#   FORMULAS
#################################################################

math:F_Delta a math:Formula ;
    rdfs:label "Delta = b^2 - 4ac"@vi ;
    math:symbolicDensity 3 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_NghiemPTB2 a math:Formula ;
    rdfs:label "Nghiem x = (-b ± sqrt(Delta)) / 2a"@vi ;
    math:symbolicDensity 4 ;
    math:applicationSteps 2 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_VietaTong a math:Formula ;
    rdfs:label "Tong nghiem S = -b/a"@vi ;
    math:aliases "Vi-et tong" ;
    math:symbolicDensity 2 ;
    math:applicationSteps 1 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_VietaTich a math:Formula ;

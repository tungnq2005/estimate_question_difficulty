    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_DienTichHinhQuat a math:Formula ;
    rdfs:label "Dien tich hinh quat S = pi*R^2*n/360"@vi ;
    math:symbolicDensity 4 ;
    math:applicationSteps 2 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_ChuViDuongTron a math:Formula ;

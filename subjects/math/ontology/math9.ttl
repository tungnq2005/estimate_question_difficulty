    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .

math:F_KhoangCach2Diem a math:Formula ;
    rdfs:label "d = sqrt((x1-x2)^2 + (y1-y2)^2)"@vi ;
    math:symbolicDensity 4 ;
    math:applicationSteps 2 ;
    math:abstractness 3 ;
    math:reasoningType "compute" ;
    math:confidence 3 .



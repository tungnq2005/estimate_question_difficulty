    phys:applicationSteps 1 ;
    phys:abstractness 2 ;
    phys:confidence 3 .

phys:F_SongSong_U a phys:Formula ;
    rdfs:label "U = U1 = U2 (mach song song)"@vi ;
    phys:symbolicDensity 2 ;
    phys:applicationSteps 1 ;
    phys:abstractness 2 ;
    phys:confidence 3 .

phys:F_SongSong_I a phys:Formula ;
    rdfs:label "I = I1 + I2 (mach song song)"@vi ;
    phys:symbolicDensity 2 ;
    phys:applicationSteps 1 ;
    phys:abstractness 3 ;
    phys:confidence 3 .

phys:F_R_DayDan a phys:Formula ;
    rdfs:label "R = rho.L / S (dien tro day dan)"@vi ;
